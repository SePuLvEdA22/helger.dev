---
import Icon from './Icon.astro';
import { skills } from '../data/site';

const accentTag: Record<string, string> = {
  primary: 'border-emerald-600/25 bg-emerald-600/10 text-emerald-700 dark:border-primary/20 dark:bg-primary/10 dark:text-primary',
  secondary: 'border-sky-600/25 bg-sky-600/10 text-sky-700 dark:border-secondary/20 dark:bg-secondary/10 dark:text-secondary',
  tertiary: 'border-indigo-500/25 bg-indigo-500/10 text-indigo-600 dark:border-tertiary/20 dark:bg-tertiary/10 dark:text-tertiary'
};
const accentFoot: Record<string, string> = {
  primary: 'text-emerald-700 dark:text-primary',
  secondary: 'text-sky-700 dark:text-secondary',
  tertiary: 'text-indigo-600 dark:text-tertiary'
};
const accentIcon: Record<string, string> = {
  primary: 'text-emerald-600 dark:text-primary',
  secondary: 'text-sky-600 dark:text-secondary',
  tertiary: 'text-indigo-500 dark:text-tertiary'
};
---

<section id="habilidades" class="relative z-10 mx-auto w-full max-w-max-container scroll-mt-24 px-margin-mobile py-16 lg:px-margin-desktop lg:py-24">
  <div class="reveal mb-10 flex flex-col gap-1">
    <span class="font-mono text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-primary">03. / Stack Técnico</span>
    <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl lg:text-4xl dark:text-white">Habilidades &amp; Herramientas</h2>
    <p class="mt-1 max-w-xl text-sm text-slate-600 sm:text-base dark:text-on-surface-variant">
      Tecnologías centrales y herramientas de desarrollo dominadas para ingeniería de software sólida.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      skills.map((s, i) => (
        <div
          class="reveal flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5 transition-all hover:bg-slate-50 dark:border-surface-container-high dark:bg-surface-container-low dark:hover:bg-surface-container"
          style={`--reveal-delay: ${(i % 4) * 80}ms`}
        >
          <div>
            <div class="mb-4 flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-slate-200/80 dark:bg-surface-container-high">
                <Icon name={s.icon} size={24} class={accentIcon[s.accent]} />
              </div>
              <span class={`rounded-full border px-2 py-0.5 font-mono text-[11px] ${accentTag[s.accent]}`}>
                {s.tag}
              </span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">{s.name}</h3>
            <span class="mb-2 block font-mono text-xs text-slate-600 dark:text-on-surface-variant">{s.meta}</span>
            <p class="text-xs leading-relaxed text-slate-600 sm:text-sm dark:text-on-surface-variant">{s.description}</p>
          </div>
          <div class="mt-4 border-t border-slate-200 pt-4 dark:border-surface-container-high/60">
            <span class={`font-mono text-xs ${accentFoot[s.accent]}`}>{s.footer}</span>
          </div>
        </div>
      ))
    }
  </div>
</section>
