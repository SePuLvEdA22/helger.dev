---
import Icon from './Icon.astro';
import { services, processSteps } from '../data/site';
import { accentTag, accentText } from '../utils/accent';
---

<section id="servicios" class="relative z-10 mx-auto w-full max-w-max-container scroll-mt-20 px-margin-mobile pt-12 pb-16 lg:px-margin-desktop lg:pt-16 lg:pb-24">
  <div class="reveal mb-10 flex flex-col gap-1">
    <span class="font-mono text-xs font-semibold uppercase tracking-widest text-orange-700 dark:text-primary">01. / Servicios</span>
    <h2 class="text-2xl font-bold tracking-tight text-stone-900 sm:text-3xl lg:text-4xl dark:text-white">¿Qué puedo construir para tu negocio?</h2>
    <p class="mt-1 max-w-xl text-sm text-stone-600 sm:text-base dark:text-on-surface-variant">
      Servicios freelance con precio cerrado y plazo definido. Cada uno respaldado por proyectos reales de este portafolio.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      services.map((s, i) => (
        <div
          class="reveal flex flex-col justify-between rounded-xl border border-stone-200 bg-white p-5 transition-all hover:bg-stone-100 sm:p-6 dark:border-surface-container-high dark:bg-surface-container-low dark:hover:bg-surface-container"
          style={`--reveal-delay: ${(i % 2) * 90}ms`}
        >
          <div>
            <div class="mb-4 flex items-center justify-between">
              <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-stone-200/80 dark:bg-surface-container-high">
                <Icon name={s.icon} size={24} class={accentText[s.accent]} />
              </div>
              <span class={`rounded-full border px-2 py-0.5 font-mono text-[11px] ${accentTag[s.accent]}`}>
                Freelance
              </span>
            </div>
            <h3 class="text-lg font-bold text-stone-900 dark:text-white">{s.title}</h3>
            <p class="mt-1 text-xs leading-relaxed text-stone-600 sm:text-sm dark:text-on-surface-variant">{s.text}</p>
          </div>
          <div class="mt-4 border-t border-stone-200 pt-4 dark:border-surface-container-high/60">
            <span class="font-mono text-xs text-stone-600 dark:text-on-surface-variant">
              {s.proof}{' '}
              {s.proofLinks?.map((l, j) => (
                <>
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class="font-semibold text-orange-800 underline-offset-4 hover:underline dark:text-primary dark:hover:text-primary-fixed">{l.label}</a>{j < (s.proofLinks?.length ?? 0) - 1 ? ' · ' : ''}
                </>
              ))}
            </span>
          </div>
        </div>
      ))
    }
  </div>

  <div class="reveal mt-12 mb-6 flex flex-col gap-1">
    <h3 class="text-xl font-bold tracking-tight text-stone-900 sm:text-2xl dark:text-white">Cómo trabajo</h3>
    <p class="max-w-xl text-sm text-stone-600 sm:text-base dark:text-on-surface-variant">
      Un proceso simple para que siempre sepas en qué punto está tu proyecto.
    </p>
  </div>

  <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      processSteps.map((p, i) => (
        <li
          class="reveal flex flex-col gap-2 rounded-xl border border-stone-200 bg-white p-5 dark:border-surface-container-high dark:bg-surface-container-low"
          style={`--reveal-delay: ${(i % 4) * 80}ms`}
        >
          <span class="font-mono text-xs font-bold text-orange-700 dark:text-primary">0{i + 1}</span>
          <h4 class="text-base font-semibold text-stone-900 dark:text-white">{p.title}</h4>
          <p class="text-xs leading-relaxed text-stone-600 sm:text-sm dark:text-on-surface-variant">{p.text}</p>
        </li>
      ))
    }
  </ol>
  <div class="reveal mt-6 flex flex-wrap items-center gap-3">
    <a href="#proyectos" class="inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-on-primary shadow-md transition-all hover:-translate-y-0.5 hover:bg-primary-fixed">
      Ver cómo lo apliqué en proyectos
      <Icon name="arrow-right" size={16} />
    </a>
    <a href="#contacto" class="inline-flex min-h-[44px] items-center gap-2 px-2 py-2 text-sm font-medium text-stone-600 underline-offset-4 hover:text-stone-900 hover:underline dark:text-on-surface-variant dark:hover:text-white">
      Pedir propuesta
    </a>
  </div>
</section>
