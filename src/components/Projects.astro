---
import Section from './Section.astro';
import Ascii from './Ascii.astro';
import { projects, site } from '../data/site';

const [featured, ...rest] = projects;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const total = String(projects.length).padStart(2, '0');
---

<Section id="proyectos" index="01" eyebrow="Proyectos" title="Cosas que he" accent="construido.">
  {/* Destacado: plano del flujo de datos */}
  <article class="reveal sheet grid gap-10 p-5 sm:p-8 lg:grid-cols-12 lg:gap-12 lg:p-10">
    <div class="lg:col-span-5">
      <p class="cap flex justify-between text-muted">
        <span class="text-accent-ink">01 / {total} · Destacado</span>
      </p>
      <h3 class="display mt-4 text-[clamp(3rem,8vw,5.5rem)]">{featured.title}</h3>
      <p class="mt-4 text-lg">{featured.summary}</p>
      <p class="mt-4 leading-relaxed text-muted">{featured.description}</p>

      <dl class="cap mt-8 divide-y divide-line border-y border-line">
        <div class="grid grid-cols-[6rem_1fr] gap-4 py-3">
          <dt class="text-muted">Stack</dt><dd>{featured.tags.join(' · ')}</dd>
        </div>
        {featured.status && (
          <div class="grid grid-cols-[6rem_1fr] gap-4 py-3">
            <dt class="text-muted">Estado</dt>
            <dd class="flex items-center gap-2 text-accent-ink">
              <span class="blink h-2 w-2 shrink-0 bg-accent" aria-hidden="true"></span>{featured.status}
            </dd>
          </div>
        )}
      </dl>

      <div class="mt-8 flex flex-wrap gap-6">
        <a href={featured.codeUrl} {...ext} class="link">Ver código</a>
        {featured.demoUrl && <a href={featured.demoUrl} {...ext} class="link">Ver demo</a>}
      </div>
    </div>

    <div class="flex flex-col justify-center lg:col-span-7">
      <div class="dim mb-4"><span>Fig. 04 · Flujo en tiempo real</span></div>
      <Ascii name="gymPlan" cols={55} rows={12} />
      <p class="cap mt-4 text-muted">
        Huella → Arduino → app → torniquete. <span class="font-bold text-accent-ink">#</span> = paquete por serial.
      </p>
    </div>
  </article>

  {/* Resto */}
  <div class="mt-8 grid gap-8 md:grid-cols-2">
    {rest.map((p, i) => (
      <article class="reveal group sheet flex flex-col p-5 sm:p-7" style={`--d: ${(i % 2) * 90}ms`}>
        <p class="cap mb-5 flex justify-between text-muted">
          <span><span class="text-accent-ink">{String(i + 2).padStart(2, '0')}</span> / {total}</span>
          <span>{p.tags[0]}</span>
        </p>
        {p.image ? (
          <div class="duotone border border-line">
            <img src={p.image} alt={`Captura de ${p.title}`} width="1280" height="800" loading="lazy" decoding="async" class="aspect-[16/10] w-full object-cover object-top" />
          </div>
        ) : (
          <div class="flex aspect-[16/10] w-full items-center justify-center border border-line" aria-hidden="true">
            <Ascii name="phone" cols={26} rows={22} class="w-[34%]" />
          </div>
        )}
        <h3 class="display mt-6 text-4xl sm:text-5xl">{p.title}</h3>
        <p class="mt-3 font-medium">{p.summary}</p>
        <p class="mt-3 leading-relaxed text-muted">{p.description}</p>
        <ul class="cap mt-5 flex flex-wrap gap-2 text-muted">
          {p.tags.map((t) => <li class="border border-line px-2 py-0.5">{t}</li>)}
        </ul>
        <div class="mt-auto flex flex-wrap gap-6 pt-6">
          {p.demoUrl && <a href={p.demoUrl} {...ext} class="link">Ver demo</a>}
          <a href={p.codeUrl} {...ext} class="link">Código</a>
        </div>
      </article>
    ))}
  </div>

  <p class="reveal cap mt-8 text-muted">
    Más en <a href={site.github} {...ext} class="link normal-case tracking-normal text-ink">github.com/{site.githubHandle}</a>
  </p>
</Section>
