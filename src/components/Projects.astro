---
import Icon from './Icon.astro';
import Section from './Section.astro';
import { projects, site } from '../data/site';

const [featured, ...rest] = projects;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<Section id="proyectos" eyebrow="Proyectos" title="Cosas que he construido">
  {/* Destacado */}
  <article class="reveal relative overflow-hidden rounded-3xl border border-line bg-surface p-7 sm:p-10 md:p-12">
    <div class="stripes pointer-events-none absolute -right-10 -top-10 h-48 w-48 rounded-full opacity-70" aria-hidden="true"></div>
    <div class="relative grid gap-8 md:grid-cols-[1fr_1.1fr] md:gap-12">
      <div>
        <p class="mb-3 text-sm font-semibold text-soft-ink">01 · Destacado</p>
        <h3 class="text-4xl font-semibold tracking-tight sm:text-5xl">{featured.title}</h3>
        <p class="mt-3 text-lg text-muted">{featured.summary}</p>
        {featured.status && (
          <p class="mt-6 inline-flex items-center gap-2 rounded-full bg-soft px-3 py-1 text-sm font-medium text-soft-ink">
            <Icon name="check" size={16} /> {featured.status}
          </p>
        )}
      </div>
      <div class="flex flex-col justify-between gap-8">
        <p class="leading-relaxed">{featured.description}</p>
        <div>
          <p class="mb-5 text-sm text-muted">{featured.tags.join(' · ')}</p>
          <div class="flex flex-wrap gap-6">
            <a href={featured.codeUrl} {...ext} class="link">Ver código</a>
            {featured.demoUrl && <a href={featured.demoUrl} {...ext} class="link">Ver demo</a>}
          </div>
        </div>
      </div>
    </div>
  </article>

  {/* Resto */}
  <div class="mt-16 grid gap-x-12 gap-y-14 md:grid-cols-2">
    {rest.map((p, i) => (
      <article class="reveal border-t border-ink/80 pt-6" style={`--d: ${(i % 2) * 90}ms`}>
        {p.image && (
          <img src={p.image} alt={`Captura de ${p.title}`} loading="lazy" class="mb-6 aspect-[16/10] w-full rounded-xl border border-line object-cover object-top" />
        )}
        <div class="flex items-baseline justify-between gap-4">
          <h3 class="text-3xl font-semibold tracking-tight">{p.title}</h3>
          <span class="text-sm tabular-nums text-muted">{String(i + 2).padStart(2, '0')}</span>
        </div>
        <p class="mt-2 font-medium">{p.summary}</p>
        <p class="mt-3 leading-relaxed text-muted">{p.description}</p>
        <p class="mt-4 text-sm text-muted">{p.tags.join(' · ')}</p>
        <div class="mt-5 flex flex-wrap gap-6">
          {p.demoUrl && <a href={p.demoUrl} {...ext} class="link">Ver demo</a>}
          <a href={p.codeUrl} {...ext} class="link">Código</a>
        </div>
      </article>
    ))}
  </div>

  <p class="reveal mt-16 text-muted">
    Más en <a href={site.github} target="_blank" rel="noopener noreferrer" class="link text-ink">github.com/{site.githubHandle}</a>
  </p>
</Section>
