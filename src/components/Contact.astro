---
import Icon from './Icon.astro';
import { site } from '../data/site';

const channelRow =
  'border-slate-200 bg-slate-100 dark:border-surface-container-high dark:bg-surface-container';
const channelRowHover =
  'hover:bg-slate-200 dark:hover:bg-surface-container-high';
const channelTitle = 'text-slate-900 dark:text-white';
const channelLabel = 'text-slate-600 dark:text-on-surface-variant';

const hasLinkedin = site.linkedin && site.linkedin !== '#';
const hasWhatsapp = site.whatsapp && site.whatsapp.length > 0;
const emailHref =
  `mailto:${site.email}` +
  `?subject=${encodeURIComponent('Propuesta de proyecto — Portafolio')}` +
  `&body=${encodeURIComponent('Hola Helger,\n\nVi tu portafolio y me gustaría hablar de un proyecto.\n\nContexto:\nPresupuesto estimado:\nPlazo:\n\nGracias.')}`;
---

<section id="contacto" class="relative z-10 mx-auto w-full max-w-max-container scroll-mt-24 px-margin-mobile py-16 lg:px-margin-desktop lg:py-24">
  <div class="reveal rounded-2xl border border-slate-200 bg-white p-6 shadow-2xl sm:p-10 lg:p-12 dark:border-surface-container-high dark:bg-surface-container-low">
    <div class="grid grid-cols-1 items-center gap-6 lg:grid-cols-12">
      <div class="flex flex-col items-start gap-2 lg:col-span-6">
        <span class="font-mono text-xs font-semibold uppercase tracking-widest text-emerald-600 dark:text-primary">04. / Conectar</span>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl dark:text-white">¿Hablamos de un proyecto?</h2>
        <p class="mt-2 max-w-lg text-sm leading-relaxed text-slate-600 sm:text-base dark:text-on-surface-variant">
          Actualmente estoy disponible para nuevas oportunidades laborales, proyectos freelance o
          colaboraciones de software de alto impacto. No dudes en escribirme directamente.
        </p>
        <div class="mt-4 flex items-center gap-2">
          <span class="h-3 w-3 animate-pulse rounded-full bg-emerald-500 dark:bg-primary"></span>
          <span class="font-mono text-xs font-medium text-emerald-700 dark:text-primary">Respuesta garantizada en menos de 24h</span>
        </div>
        <div class="mt-4 flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <a
            href={emailHref}
            class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-on-primary shadow-lg shadow-primary/25 transition-all hover:-translate-y-0.5 hover:bg-primary-fixed"
          >
            <Icon name="send" size={18} />
            <span>Escríbeme directo</span>
          </a>
          <a
            href={site.cvUrl}
            download
            class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-6 py-3 text-sm font-medium text-slate-900 shadow-sm transition-all hover:bg-slate-100 dark:border-surface-container-high dark:bg-surface-container dark:text-white dark:hover:bg-surface-container-high"
          >
            <Icon name="arrow-down" size={18} class="text-emerald-600 dark:text-primary" />
            <span>Descargar CV</span>
          </a>
        </div>
      </div>

      <div class="flex w-full flex-col gap-3 lg:col-span-6">
        <div class={`flex items-center justify-between gap-3 rounded-xl border p-4 ${channelRow}`}>
          <div class="flex min-w-0 items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-emerald-600/25 bg-emerald-600/10 text-emerald-600 dark:border-primary/20 dark:bg-surface-container-high dark:text-primary">
              <Icon name="mail" size={20} />
            </div>
            <div class="flex min-w-0 flex-col">
              <span class={`font-mono text-[11px] ${channelLabel}`}>Correo Electrónico</span>
              <a
                href={emailHref}
                class="truncate text-sm font-semibold text-slate-900 transition-colors hover:text-emerald-700 sm:text-base dark:text-white dark:hover:text-primary"
              >
                {site.email}
              </a>
            </div>
          </div>
          <button
            id="copy-email-btn"
            type="button"
            data-email={site.email}
            title="Copiar correo"
            aria-label="Copiar correo electrónico"
            class="flex min-h-[44px] shrink-0 items-center gap-1.5 rounded-lg border border-slate-300 bg-slate-200 px-3 py-1.5 font-mono text-xs text-slate-700 transition-colors hover:bg-slate-300 dark:border-surface-container-highest dark:bg-surface-container-high dark:text-white dark:hover:bg-surface-container-highest"
          >
            <Icon name="copy" size={16} />
            <span id="copy-email-text" class="hidden sm:inline" aria-live="polite">Copiar</span>
          </button>
        </div>

        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class={`flex items-center justify-between gap-3 rounded-xl border p-4 transition-all ${channelRow} ${channelRowHover}`}
        >
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-sky-600/25 bg-sky-600/10 text-sky-600 dark:border-secondary/20 dark:bg-surface-container-high dark:text-secondary">
              <Icon name="github" size={20} />
            </div>
            <div class="flex flex-col">
              <span class={`font-mono text-[11px] ${channelLabel}`}>GitHub Perfil</span>
              <span class={`text-sm font-semibold sm:text-base ${channelTitle}`}>{site.githubHandle}</span>
            </div>
          </div>
          <Icon name="arrow-up-right" size={18} class={channelLabel} />
        </a>

        {hasLinkedin && (
          <a
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class={`flex min-h-[44px] items-center justify-between gap-3 rounded-xl border p-4 transition-all ${channelRow} ${channelRowHover}`}
          >
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-indigo-500/25 bg-indigo-500/10 text-indigo-500 dark:border-tertiary/20 dark:bg-surface-container-high dark:text-tertiary">
                <Icon name="linkedin" size={20} />
              </div>
              <div class="flex flex-col">
                <span class={`font-mono text-[11px] ${channelLabel}`}>LinkedIn</span>
                <span class={`text-sm font-semibold sm:text-base ${channelTitle}`}>Conectar en LinkedIn</span>
              </div>
            </div>
            <Icon name="arrow-up-right" size={18} class={channelLabel} />
          </a>
        )}

        {hasWhatsapp && (
          <a
            href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent('Hola Helger, vi tu portafolio y quiero hablar de un proyecto.')}`}
            target="_blank"
            rel="noopener noreferrer"
            class={`flex min-h-[44px] items-center justify-between gap-3 rounded-xl border p-4 transition-all ${channelRow} ${channelRowHover}`}
          >
            <div class="flex items-center gap-3">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-emerald-600/25 bg-emerald-600/10 text-emerald-600 dark:border-primary/20 dark:bg-surface-container-high dark:text-primary">
                <Icon name="send" size={20} />
              </div>
              <div class="flex flex-col">
                <span class={`font-mono text-[11px] ${channelLabel}`}>WhatsApp</span>
                <span class={`text-sm font-semibold sm:text-base ${channelTitle}`}>Chat directo</span>
              </div>
            </div>
            <Icon name="arrow-up-right" size={18} class={channelLabel} />
          </a>
        )}

        <div class={`flex items-center justify-between rounded-xl border px-4 py-2.5 font-mono text-xs ${channelLabel} border-slate-200 bg-slate-200/60 dark:border-surface-container-high dark:bg-surface-container-high/50`}>
          <div class="flex items-center gap-2">
            <Icon name="map-pin" size={16} class="text-sky-600 dark:text-secondary" />
            <span>{site.location} • {site.timezone}</span>
          </div>
          <span class="font-semibold text-emerald-700 dark:text-primary">Remoto / Híbrido</span>
        </div>
      </div>
    </div>
  </div>
</section>
