---
import Icon from './Icon.astro';
import { site } from '../data/site';

const mailto =
  `mailto:${site.email}?subject=${encodeURIComponent('Hola Helger')}`;
const ext = { target: '_blank', rel: 'noopener noreferrer' };
---

<section id="contacto" class="relative overflow-hidden py-24 md:py-36">
  <div class="dots pointer-events-none absolute -left-16 bottom-0 h-64 w-64 rounded-full" aria-hidden="true"></div>
  <div class="relative mx-auto max-w-page px-5 sm:px-8">
    <p class="reveal mb-3 text-sm font-semibold uppercase tracking-[0.14em] text-accent-ink">Contacto</p>
    <h2 class="reveal max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
      ¿Hablamos? <em class="font-medium text-accent">Escríbeme.</em>
    </h2>
    <p class="reveal mt-6 max-w-xl text-lg text-muted">
      Ya sea un proyecto freelance o una oportunidad laboral, respondo en menos de 24 horas.
    </p>

    <div class="reveal mt-10 flex flex-wrap items-center gap-4">
      <a href={mailto} class="link break-all font-display text-2xl sm:text-4xl">{site.email}</a>
      <button
        type="button"
        data-copy={site.email}
        aria-label="Copiar correo"
        class="inline-flex min-h-[40px] items-center gap-2 rounded-full border border-line bg-surface px-4 text-sm font-medium text-muted transition-colors hover:border-ink hover:text-ink"
      >
        <Icon name="copy" size={16} /> <span data-copy-label aria-live="polite">Copiar</span>
      </button>
    </div>

    <ul class="reveal mt-10 flex flex-wrap gap-x-8 gap-y-3">
      <li><a href={site.github} {...ext} class="link">GitHub</a></li>
      {site.linkedin && <li><a href={site.linkedin} {...ext} class="link">LinkedIn</a></li>}
      {site.cvUrl && <li><a href={site.cvUrl} download class="link">Descargar CV</a></li>}
    </ul>
  </div>
</section>
