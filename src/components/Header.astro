---
import Icon from './Icon.astro';

const links = [
  { href: '#proyectos', label: 'Proyectos', n: '01' },
  { href: '#sobre-mi', label: 'Sobre mí', n: '02' },
  { href: '#freelance', label: 'Freelance', n: '03' },
];
---

<header id="site-header" class="sticky top-0 z-50 border-b border-line bg-bg/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-2 px-5 sm:px-8">
    <a href="#inicio" class="whitespace-nowrap py-2 font-mono text-[0.8rem] font-semibold uppercase tracking-[0.22em] min-[380px]:text-sm">
      Helger<span class="text-accent">_</span>Santiago
    </a>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      {/* Escritorio */}
      <nav aria-label="Principal" class="hidden items-center md:flex">
        {links.map((l) => (
          <a href={l.href} data-nav class="cap px-3 py-3 text-muted transition-colors hover:text-ink aria-[current=true]:text-ink">
            <span class="text-accent-ink">{l.n}</span> {l.label}
          </a>
        ))}
      </nav>
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar entre modo claro y oscuro"
        class="inline-flex h-11 w-11 items-center justify-center text-muted transition-colors hover:text-ink"
      >
        <Icon name="moon" size={18} class="theme-icon-moon" />
        <Icon name="sun" size={18} class="theme-icon-sun" />
      </button>
      <a href="#contacto" class="btn btn-primary hidden min-h-[44px] px-4 text-xs md:inline-flex">
        Contacto
      </a>

      {/* Móvil: botón de menú */}
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        class="cap inline-flex min-h-[44px] items-center gap-2 border border-line px-3 text-ink transition-colors hover:border-ink md:hidden"
      >
        <span data-menu-label>Menú</span>
        <Icon name="menu" size={16} class="menu-icon-open" />
        <Icon name="x" size={16} class="menu-icon-close hidden" />
      </button>
    </div>
  </div>

  {/* Móvil: panel desplegable */}
  <nav
    id="mobile-nav"
    aria-label="Principal"
    hidden
    class="absolute inset-x-0 top-full border-b border-line bg-bg md:hidden"
  >
    <ul class="mx-auto max-w-page px-5 py-4 sm:px-8">
      {links.map((l) => (
        <li class="border-b border-line">
          <a href={l.href} data-nav class="flex min-h-[64px] items-center gap-4 py-3 aria-[current=true]:text-accent">
            <span class="cap text-accent-ink">{l.n}</span>
            <span class="display text-4xl">{l.label}</span>
          </a>
        </li>
      ))}
      <li class="pt-5">
        <a href="#contacto" class="btn btn-primary w-full justify-between">
          04 · Contacto <Icon name="arrow-right" size={16} />
        </a>
      </li>
    </ul>
    <p class="cap mx-auto max-w-page px-5 pb-5 text-muted sm:px-8">Cúcuta, Colombia · GMT-5</p>
  </nav>
</header>

<style>
  #mobile-nav:not([hidden]) {
    animation: menu-in 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #mobile-nav:not([hidden]) { animation: none; }
  }
</style>

<script>
  const btn = document.getElementById('menu-toggle');
  const panel = document.getElementById('mobile-nav');
  const header = document.getElementById('site-header');

  const setOpen = (open: boolean) => {
    if (!btn || !panel) return;
    panel.hidden = !open;
    btn.setAttribute('aria-expanded', String(open));
    btn.querySelector('[data-menu-label]')!.textContent = open ? 'Cerrar' : 'Menú';
    btn.querySelector('.menu-icon-open')?.classList.toggle('hidden', open);
    btn.querySelector('.menu-icon-close')?.classList.toggle('hidden', !open);
  };

  btn?.addEventListener('click', () => setOpen(Boolean(panel?.hidden)));
  // Al elegir una sección, al pulsar Escape o al tocar fuera, se cierra
  panel?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && panel && !panel.hidden) { setOpen(false); btn?.focus(); }
  });
  document.addEventListener('click', (e) => {
    if (panel && !panel.hidden && !header?.contains(e.target as Node)) setOpen(false);
  });
  // Si se agranda la pantalla con el menú abierto, se cierra
  matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && setOpen(false));

  // Sección activa: marca el enlace con aria-current
  const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')];
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const id = '#' + e.target.id;
      navLinks.forEach((a) => a.setAttribute('aria-current', String(a.getAttribute('href') === id)));
    }
  }, { rootMargin: '-45% 0px -50% 0px' });
  ['proyectos', 'sobre-mi', 'freelance', 'contacto', 'inicio'].forEach((id) => {
    const s = document.getElementById(id);
    if (s) io.observe(s);
  });
</script>
