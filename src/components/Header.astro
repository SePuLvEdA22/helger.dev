---
import Icon from './Icon.astro';
import { site } from '../data/site';

const links = [
  { href: '#inicio', label: 'Inicio', path: 'inicio' },
  { href: '#sobre-mi', label: 'Sobre mí', path: 'sobre-mi' },
  { href: '#proyectos', label: 'Proyectos', path: 'proyectos' },
  { href: '#habilidades', label: 'Habilidades', path: 'habilidades' },
  { href: '#contacto', label: 'Contacto', path: 'contacto' }
];

// Clases de estado del scroll-spy. Se alternan con classList (nunca se
// reescribe className) para no romper las clases base de layout.
// NOTA: mismo font-weight en ambos estados para que el pill activo no
// cambie de ancho y se salga del contenedor (el activo se distingue por fondo).
const ACTIVE = 'font-medium bg-primary text-on-primary shadow-sm';
const INACTIVE =
  'font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-200/70 dark:text-on-surface-variant dark:hover:text-white dark:hover:bg-surface-container-high';

// Botones de icono del header (tema, GitHub, menú) en ambos modos.
const ICON_BTN =
  'min-h-[44px] min-w-[44px] border-slate-300/70 bg-slate-200/60 text-slate-600 hover:bg-slate-300 hover:text-slate-900 dark:border-surface-container-high/50 dark:bg-surface-container-low dark:text-on-surface-variant dark:hover:bg-surface-container-high dark:hover:text-on-surface';
---

<header
  class="fixed top-0 z-50 w-full border-b border-slate-200 bg-white/85 shadow-lg backdrop-blur-xl dark:border-surface-container-high/60 dark:bg-surface/85"
>
  <div
    class="mx-auto flex h-16 max-w-max-container items-center justify-between gap-2 px-margin-mobile sm:gap-4 lg:px-margin-desktop"
  >
    <a
      href="#inicio"
      class="group flex min-w-0 items-center gap-2.5"
      aria-label="Ir al inicio"
    >
      <span
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg border border-emerald-600/30 bg-emerald-600/10 font-mono text-sm font-bold text-emerald-700 shadow-sm transition-transform group-hover:scale-105 dark:border-primary/30 dark:bg-surface-container-low dark:text-primary"
        aria-hidden="true"
      >
        &gt;_
      </span>
      <span class="flex min-w-0 flex-col leading-tight">
        <span class="truncate font-display text-lg font-bold tracking-tight text-slate-900 dark:text-white">{site.brand}</span>
        <span class="truncate font-mono text-[11px] text-emerald-600/90 dark:text-primary/80">Systems Architect</span>
      </span>
    </a>

    {/* Nav desktop solo en xl: en lg (1024–1280px) brand + 5 links + acciones no caben */}
    <nav
      class="hidden min-w-0 items-center gap-1 rounded-full border border-slate-300/70 bg-slate-200/50 p-1.5 xl:flex dark:border-surface-container-high/60 dark:bg-surface-container-lowest/80"
      aria-label="Navegación principal"
    >
      {
        links.map((l, i) => (
          <a
            href={l.href}
            data-path={l.path}
            data-active={i === 0 ? 'true' : 'false'}
            aria-current={i === 0 ? 'page' : undefined}
            class={`nav-item shrink-0 whitespace-nowrap rounded-full px-3.5 py-1.5 text-sm transition-colors ${i === 0 ? ACTIVE : INACTIVE}`}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar entre modo oscuro y claro"
        class={`flex h-9 w-9 items-center justify-center rounded-xl border transition-all ${ICON_BTN}`}
      >
        <span id="theme-icon-moon"><Icon name="moon" size={18} /></span>
        <span id="theme-icon-sun" class="hidden"><Icon name="sun" size={18} /></span>
      </button>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Perfil de GitHub"
        class={`hidden h-9 w-9 items-center justify-center rounded-xl border transition-all min-[420px]:flex ${ICON_BTN}`}
      >
        <Icon name="github" size={18} />
      </a>
      <a
        href="#contacto"
        class="hidden items-center gap-1.5 whitespace-nowrap rounded-xl border border-emerald-600/30 bg-emerald-600/10 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-emerald-700 transition-all hover:bg-emerald-500 hover:text-white md:inline-flex dark:border-primary/40 dark:bg-primary/15 dark:text-primary dark:hover:bg-primary dark:hover:text-on-primary"
      >
        <Icon name="send" size={15} />
        <span>Contactar</span>
      </a>
      <button
        id="menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class={`flex h-9 w-9 items-center justify-center rounded-xl border transition-all xl:hidden ${ICON_BTN}`}
      >
        <span id="menu-icon-open"><Icon name="menu" size={18} /></span>
        <span id="menu-icon-close" class="hidden"><Icon name="x" size={18} /></span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-slate-200 px-margin-mobile py-3 xl:hidden dark:border-surface-container-high/60" aria-label="Navegación móvil">
    <div class="flex flex-col gap-1">
      {
        links.map((l) => (
          <a
            href={l.href}
            data-path={l.path}
            class="mobile-link flex min-h-[44px] items-center rounded-lg px-3 py-2 text-sm font-medium text-slate-600 transition-colors hover:bg-slate-200 hover:text-slate-900 dark:text-on-surface-variant dark:hover:bg-surface-container-high dark:hover:text-white"
          >
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline define:vars={{ ACTIVE, INACTIVE }}>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const setMenu = (open) => {
      menu?.classList.toggle('hidden', !open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      btn?.setAttribute('aria-expanded', String(open));
      btn?.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    };
    btn?.addEventListener('click', () => {
      setMenu(menu?.classList.contains('hidden') ?? true);
    });
    menu?.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setMenu(false));
    });

    // Scroll-spy con IntersectionObserver: marca la sección que cruza la
    // banda central del viewport. A diferencia del cálculo con offsetTop,
    // funciona también con la última sección aunque el pie de página sea
    // más bajo que el viewport (caso Contacto).
    const activeClasses = ACTIVE.split(' ');
    const inactiveClasses = INACTIVE.split(' ');
    const navLinks = Array.from(
      document.querySelectorAll('header nav[aria-label="Navegación principal"] a.nav-item')
    );
    const setActive = (path) => {
      navLinks.forEach((link) => {
        const linkPath = link.getAttribute('data-path') || (link.getAttribute('href') || '').replace('#', '');
        const isActive = linkPath === path;
        link.classList.remove(...(isActive ? inactiveClasses : activeClasses));
        link.classList.add(...(isActive ? activeClasses : inactiveClasses));
        if (isActive) link.setAttribute('aria-current', 'page');
        else link.removeAttribute('aria-current');
      });
    };
    // Feedback inmediato al hacer click + bloqueo de navegación: durante el
    // scroll suave el observer ignora las secciones de paso para que el
    // activo no "rebote" por Inicio, Sobre mí, etc. hasta llegar al destino.
    let navTarget = null;
    let navTimer = null;
    const releaseNavLock = () => {
      navTarget = null;
      if (navTimer) clearTimeout(navTimer);
      navTimer = null;
    };
    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const path = link.getAttribute('data-path') || (link.getAttribute('href') || '').replace('#', '');
        releaseNavLock();
        navTarget = path;
        setActive(path);
        // Red de seguridad por si el destino nunca intersecta.
        navTimer = setTimeout(releaseNavLock, 2500);
      });
    });
    // Si el usuario toma el control manual, se libera el bloqueo.
    window.addEventListener('wheel', releaseNavLock, { passive: true });
    window.addEventListener('touchmove', releaseNavLock, { passive: true });
    const sections = document.querySelectorAll('main section[id]');
    if ('IntersectionObserver' in window && sections.length > 0) {
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const id = entry.target.getAttribute('id') || '';
            // Con bloqueo activo solo el destino puede tomar el activo;
            // al llegar se libera para volver al modo libre.
            if (navTarget) {
              if (id === navTarget) {
                setActive(id);
                releaseNavLock();
              }
              return;
            }
            setActive(id);
          });
        },
        { rootMargin: '-40% 0px -55% 0px', threshold: 0 }
      );
      sections.forEach((s) => spy.observe(s));
    } else {
      // Fallback sin IntersectionObserver: primera sección visible.
      const onScroll = () => {
        if (navTarget) return;
        let current = '';
        const pos = window.scrollY + 180;
        sections.forEach((s) => {
          if (pos >= s.offsetTop && pos < s.offsetTop + s.offsetHeight) {
            current = s.getAttribute('id') || '';
          }
        });
        if (current) setActive(current);
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  });
</script>
