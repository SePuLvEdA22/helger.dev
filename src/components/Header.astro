---
import Icon from './Icon.astro';
import { site } from '../data/site';

const links = [
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#freelance', label: 'Freelance' },
];
---

<header class="sticky top-0 z-50 border-b border-line/70 bg-bg/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-5 sm:px-8">
    <a href="#inicio" class="font-display text-xl font-semibold tracking-tight">
      {site.name}<span class="text-accent">.</span>
    </a>
    <nav aria-label="Principal" class="flex items-center gap-1 sm:gap-2">
      {links.map((l) => (
        <a href={l.href} class="hidden rounded-md px-3 py-2 text-sm font-medium text-muted transition-colors hover:text-ink md:block">
          {l.label}
        </a>
      ))}
      <button
        id="theme-toggle"
        type="button"
        aria-label="Cambiar entre modo claro y oscuro"
        class="ml-1 inline-flex h-10 w-10 items-center justify-center rounded-full text-muted transition-colors hover:bg-surface hover:text-ink"
      >
        <Icon name="moon" size={18} class="theme-icon-moon" />
        <Icon name="sun" size={18} class="theme-icon-sun" />
      </button>
      <a
        href="#contacto"
        class="ml-1 inline-flex min-h-[40px] items-center rounded-full bg-ink px-4 text-sm font-semibold text-bg transition-colors hover:bg-accent-ink"
      >
        Contacto
      </a>
    </nav>
  </div>
</header>
