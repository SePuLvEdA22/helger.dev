---
// Avatar ilustrado (inspirado en robbowen.digital): respira, parpadea y
// sigue el cursor con parallax por capas. Las capas se mueven con --mx/--my
// (-1..1), que actualiza el script de abajo. Rasgos basados en una selfie de Helger.
---

<div id="avatar" class="avatar relative mx-auto aspect-square w-full max-w-[16rem] md:max-w-[24rem]" aria-hidden="true">
  <div class="dots absolute -right-5 -top-5 h-2/3 w-2/3 rounded-full"></div>
  <div class="stripes absolute -bottom-3 -left-3 h-1/3 w-1/3 rounded-full"></div>

  <svg viewBox="0 0 400 400" class="relative h-full w-full overflow-visible">
    <defs>
      <clipPath id="avatar-clip"><circle cx="200" cy="200" r="180" /></clipPath>
      <pattern id="av-stubble" width="5" height="5" patternUnits="userSpaceOnUse">
        <circle cx="2.5" cy="2.5" r="0.9" fill="var(--av-ink)" />
      </pattern>
    </defs>
    <circle class="av-circle" cx="200" cy="200" r="180" fill="var(--color-soft)" stroke="var(--color-line)" stroke-width="2" />

    <g clip-path="url(#avatar-clip)" stroke="var(--av-ink)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round">
      <g class="av-in">
        <g class="av-breath">
          {/* Cuerpo: camiseta negra cuello redondo. Se mueve poco */}
          <g class="av-layer" style="--k: 4">
            <path d="M176 284 L176 330 Q200 346 224 330 L224 284 Z" fill="var(--av-face)" />
            <path d="M62 430 Q70 336 176 322 Q200 336 224 322 Q330 336 338 430 Z" fill="var(--av-ink)" />
            <path d="M174 326 Q200 344 226 326" fill="none" stroke="var(--color-soft-ink)" stroke-width="3" />
          </g>

          {/* Cabeza: gira un poco más */}
          <g class="av-layer av-tilt" style="--k: 9">
            <ellipse cx="128" cy="218" rx="12" ry="19" fill="var(--av-face)" />
            <ellipse cx="272" cy="218" rx="12" ry="19" fill="var(--av-face)" />
            {/* Cara ovalada con mandíbula marcada */}
            <path d="M130 190 Q128 268 166 296 Q200 314 234 296 Q272 268 270 190 Q268 124 200 120 Q132 124 130 190 Z" fill="var(--av-face)" />

            {/* Rasgos: la capa más cercana, mayor desplazamiento */}
            <g class="av-layer" style="--k: 7">
              {/* Barba de pocos días: bigote + mentón */}
              <path d="M156 262 Q162 294 200 306 Q238 294 244 262 Q234 276 222 274 Q210 266 200 266 Q190 266 178 274 Q166 276 156 262 Z" fill="url(#av-stubble)" stroke="none" opacity="0.5" />
              <path d="M178 258 Q200 248 222 258 Q212 262 200 260 Q188 262 178 258 Z" fill="url(#av-stubble)" stroke="none" opacity="0.5" />
              <path class="av-mouth" d="M184 272 Q200 280 216 272" fill="none" />
              <path d="M200 228 Q192 246 206 249" fill="none" stroke-width="4" />

              <g class="av-layer" style="--k: 4">
                <g class="av-blink">
                  <circle cx="170" cy="212" r="7" fill="var(--av-ink)" stroke="none" />
                  <circle cx="230" cy="212" r="7" fill="var(--av-ink)" stroke="none" />
                </g>
              </g>

              {/* Gafas rectangulares de montura gruesa */}
              <g fill="none" stroke-width="7">
                <rect x="144" y="194" width="50" height="38" rx="7" />
                <rect x="206" y="194" width="50" height="38" rx="7" />
                <path d="M194 204 Q200 199 206 204" stroke-width="5" />
                <path d="M144 202 L132 198" stroke-width="5" />
                <path d="M256 202 L268 198" stroke-width="5" />
              </g>
              <path class="av-glint" d="M150 212 L157 201 M212 212 L219 201" fill="none" stroke="var(--av-glint)" stroke-width="4" />

              <path class="av-brow" d="M146 180 Q166 174 188 178" fill="none" stroke-width="8" />
              <path class="av-brow" d="M212 178 Q234 174 254 180" fill="none" stroke-width="8" />
            </g>

            {/* Pelo rizado: volumen arriba, lados cortos y rizos sobre la frente */}
            <g fill="var(--av-ink)" stroke="none">
              <path d="M124 206 Q116 150 146 122 Q172 100 200 102 Q240 100 260 122 Q286 150 276 206 Q268 172 250 160 Q200 150 150 160 Q132 172 124 206 Z" />
              <circle cx="130" cy="196" r="11" />
              <circle cx="132" cy="172" r="16" />
              <circle cx="140" cy="144" r="21" />
              <circle cx="162" cy="116" r="24" />
              <circle cx="194" cy="104" r="25" />
              <circle cx="228" cy="108" r="24" />
              <circle cx="256" cy="130" r="21" />
              <circle cx="268" cy="160" r="16" />
              <circle cx="270" cy="188" r="11" />
              <circle cx="160" cy="154" r="13" />
              <circle cx="186" cy="157" r="14" />
              <circle cx="212" cy="155" r="13" />
              <circle cx="238" cy="152" r="12" />
            </g>
            <g fill="none" stroke="var(--color-soft-ink)" stroke-width="3" opacity="0.8">
              <path d="M152 112 q7 -8 15 -1" />
              <path d="M186 96 q7 -7 14 0" />
              <path d="M222 100 q7 -6 13 2" />
              <path d="M132 144 q5 -7 12 -3" />
              <path d="M252 128 q6 -5 11 2" />
              <path d="M180 156 q5 5 11 1" />
              <path d="M128 182 q4 -5 9 -2" />
              <path d="M264 172 q4 -5 9 0" />
            </g>
          </g>
        </g>
      </g>
    </g>
  </svg>
</div>

<style>
  .avatar {
    --mx: 0;
    --my: 0;
    /* Colores propios: la ilustración no se invierte en modo oscuro */
    --av-ink: #151a3d;
    --av-face: #fffdf9;
    --av-glint: #cfe8e6;
  }
  .av-layer {
    transform: translate(calc(var(--mx) * var(--k) * 1px), calc(var(--my) * var(--k) * 0.8px));
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .av-tilt {
    transform-box: view-box;
    transform-origin: 200px 300px;
    transform: translate(calc(var(--mx) * var(--k) * 1px), calc(var(--my) * var(--k) * 0.8px))
      rotate(calc(var(--mx) * 4deg));
  }
  .av-blink {
    transform-box: fill-box;
    transform-origin: center;
    animation: av-blink 5s infinite;
  }
  .av-breath {
    animation: av-breath 4.5s ease-in-out infinite;
  }
  .av-in {
    animation: av-in 0.9s 0.25s cubic-bezier(0.22, 1, 0.36, 1) both;
  }
  .av-circle {
    transform-box: fill-box;
    transform-origin: center;
    animation: av-pop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  .av-mouth,
  .av-brow {
    transition: d 0.3s ease;
  }
  .avatar:hover .av-mouth {
    d: path('M182 268 Q200 286 218 268');
  }
  .avatar:hover .av-brow:first-of-type {
    d: path('M146 172 Q166 164 188 170');
  }

  @keyframes av-blink {
    0%, 92%, 100% { transform: scaleY(1); }
    95% { transform: scaleY(0.1); }
  }
  @keyframes av-breath {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }
  @keyframes av-in {
    from { transform: translateY(70px); }
  }
  @keyframes av-pop {
    from { transform: scale(0.6); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .av-blink, .av-breath, .av-in, .av-circle { animation: none; }
    .av-layer { transition: none; }
  }
</style>

<script>
  const el = document.getElementById('avatar');
  const canFollow =
    matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && canFollow) {
    let frame = 0;
    const clamp = (n: number) => Math.max(-1, Math.min(1, n));
    window.addEventListener('pointermove', (e) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const r = el.getBoundingClientRect();
        el.style.setProperty('--mx', clamp((e.clientX - (r.left + r.width / 2)) / (innerWidth / 2)).toFixed(3));
        el.style.setProperty('--my', clamp((e.clientY - (r.top + r.height / 2)) / (innerHeight / 2)).toFixed(3));
      });
    }, { passive: true });
  }
</script>
