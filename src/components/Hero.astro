---
import Icon from './Icon.astro';
import { site } from '../data/site';

const profile = {
  developer: 'Helger Santiago',
  role: 'Software Engineer & Architect',
  status: 'Available',
  location: 'Cúcuta, Colombia',
  core: ['JavaScript', 'Electron', 'Next.js', 'Node.js'],
  cloud_and_ops: ['Docker', 'AWS', 'CI/CD'],
  hardware_io: ['Arduino', 'IoT Controllers'],
};

const jsonPretty = JSON.stringify(profile, null, 2);
---

<section
  id="inicio"
  class="relative z-10 mx-auto flex min-h-[calc(90vh-5rem)] w-full max-w-max-container scroll-mt-20 flex-col justify-center px-margin-mobile pb-16 pt-10 lg:px-margin-desktop"
>
  <!-- Fondo retícula -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-20 [mask-image:radial-gradient(ellipse_at_top,black,transparent_75%)] dark:opacity-20"
  >
    <svg class="h-full w-full" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="matrix-grid" width="48" height="48" patternUnits="userSpaceOnUse">
          <path d="M 48 0 L 0 0 0 48" fill="none" stroke="rgba(194, 65, 12, 0.28)" stroke-width="1"></path>
          <circle cx="0" cy="0" fill="rgba(87, 83, 78, 0.5)" r="1.5"></circle>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#matrix-grid)"></rect>
    </svg>
  </div>

  <div class="relative grid min-w-0 max-w-full grid-cols-1 items-center gap-6 lg:grid-cols-12">
    <div class="flex min-w-0 flex-col items-start gap-4 lg:col-span-7">
      <div class="flex flex-wrap items-center gap-2" data-hero>
        <div
          class="inline-flex items-center gap-2 rounded-full border border-orange-700/30 bg-white px-3 py-1 shadow-sm dark:border-primary/30 dark:bg-surface-container-high/80"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="absolute h-full w-full animate-ping rounded-full bg-orange-600 opacity-75 dark:bg-primary"></span>
            <span class="h-2 w-2 rounded-full bg-orange-600 dark:bg-primary"></span>
          </span>
          <span class="font-mono text-[11px] font-semibold uppercase tracking-wider text-orange-800 dark:text-primary">
            {site.availability}
          </span>
        </div>
        <div
          class="inline-flex items-center gap-1.5 rounded-full border border-stone-200 bg-white px-3 py-1 font-mono text-xs text-stone-600 dark:border-surface-container-high dark:bg-surface-container dark:text-on-surface-variant"
        >
          <Icon name="map-pin" size={15} class="text-stone-600 dark:text-secondary" />
          <span>{site.location}</span>
        </div>
      </div>

      <div class="mt-2 flex flex-col gap-2" data-hero>
        <span class="text-xl font-medium tracking-tight text-stone-600 md:text-2xl dark:text-on-surface-variant">
          Hola, soy <span class="font-bold text-stone-900 dark:text-white">{site.name}</span>
        </span>
        <h1
          class="text-4xl font-extrabold leading-[1.1] tracking-tight text-stone-900 sm:text-5xl lg:text-6xl dark:text-white"
        >
          <span lang="en" class="bg-gradient-to-r from-orange-700 via-stone-600 to-amber-800 bg-clip-text text-transparent dark:from-primary dark:via-secondary dark:to-tertiary">
            {site.role}
          </span>
          {' '}{site.roleSuffix}
        </h1>
      </div>

      <p class="max-w-2xl text-base leading-relaxed text-stone-600 sm:text-lg dark:text-on-surface-variant" data-hero>
        {site.tagline}
      </p>

      <div class="flex w-full flex-wrap items-center gap-3 pt-2 sm:w-auto" data-hero>
        <a
          href="#proyectos"
          class="inline-flex min-h-[44px] transform items-center justify-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-on-primary shadow-lg shadow-primary/25 transition-all hover:-translate-y-0.5 hover:bg-primary-fixed"
        >
          <span>Ver proyectos</span>
          <Icon name="arrow-down" size={18} />
        </a>
        <a
          href="#contacto"
          class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl border border-stone-300 bg-white px-6 py-3 text-sm font-medium text-stone-900 shadow-sm transition-all hover:bg-stone-100 dark:border-surface-container-high dark:bg-surface-container dark:text-white dark:hover:bg-surface-container-high"
        >
          <Icon name="send" size={18} class="text-stone-600 dark:text-secondary" />
          <span>Contactarme</span>
        </a>
        {site.cvUrl && (
          <a
            href={site.cvUrl}
            download
            class="inline-flex min-h-[44px] items-center justify-center gap-2 rounded-xl border border-orange-700/30 bg-orange-700/10 px-6 py-3 text-sm font-semibold text-orange-800 transition-all hover:bg-orange-600 hover:text-white dark:border-primary/40 dark:bg-primary/15 dark:text-primary dark:hover:bg-primary dark:hover:text-on-primary"
          >
            <Icon name="arrow-down" size={18} />
            <span>Descargar CV</span>
          </a>
        )}
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-[44px] items-center gap-1.5 px-2 py-2 font-mono text-xs text-stone-600 underline-offset-4 transition-colors hover:text-orange-800 hover:underline dark:text-on-surface-variant dark:hover:text-primary"
        >
          <Icon name="terminal" size={16} />
          <span>{site.githubHandle}</span>
          <Icon name="arrow-up-right" size={14} />
        </a>
      </div>
    </div>

    {/* Consola: terminal oscura en dark, clara en light */}
    <div class="mt-8 w-full min-w-0 lg:col-span-5 lg:mt-0" data-hero>
      <div
        class="relative max-w-full overflow-hidden rounded-xl border border-stone-200 bg-white shadow-2xl dark:border-surface-container-high dark:bg-surface-container-low"
      >
        <div
          class="flex items-center justify-between border-b border-stone-200 bg-stone-100 px-4 py-2.5 dark:border-surface-container-highest dark:bg-surface-container-high"
        >
          <div class="flex items-center gap-2">
            <span class="inline-block h-3 w-3 rounded-full bg-rose-500"></span>
            <span class="inline-block h-3 w-3 rounded-full bg-amber-500"></span>
            <span class="inline-block h-3 w-3 rounded-full bg-orange-600"></span>
            <span class="ml-2 font-mono text-xs text-stone-600 dark:text-on-surface-variant">devcore.config.json</span>
          </div>
          <div class="flex items-center gap-2 text-stone-500 dark:text-on-surface-variant">
            <Icon name="lock" size={15} />
            <span class="font-mono text-[11px] text-orange-700 dark:text-primary/90">v2.4.0-stable</span>
          </div>
        </div>
        <div class="terminal-scroll overflow-x-auto bg-stone-100 p-4 font-mono text-[12px] leading-relaxed sm:p-5 sm:text-[13px] dark:bg-[#080e1a]">
          <pre lang="en" class="w-max min-w-full pr-4 text-stone-900 dark:text-on-surface"><span class="text-tertiary">{'{'}</span>
  <span class="text-secondary">"developer"</span>: <span class="text-orange-800 dark:text-primary-fixed">"{profile.developer}"</span>,
  <span class="text-secondary">"role"</span>: <span class="text-orange-800 dark:text-primary-fixed">"{profile.role}"</span>,
  <span class="text-secondary">"status"</span>: <span class="text-primary">"{profile.status}"</span>,
  <span class="text-secondary">"location"</span>: <span class="text-orange-800 dark:text-primary-fixed">"{profile.location}"</span>,
  <span class="text-secondary">"core"</span>: [
    {profile.core.map((tech, i) => (
      <><span class="text-primary">"{tech}"</span>{i < profile.core.length - 1 ? ',' : ''}{'\n    '}</>
    ))}
  ],
  <span class="text-secondary">"cloud_and_ops"</span>: [
    {profile.cloud_and_ops.map((tech, i) => (
      <><span class="text-secondary">"{tech}"</span>{i < profile.cloud_and_ops.length - 1 ? ',' : ''}{'\n    '}</>
    ))}
  ],
  <span class="text-secondary">"hardware_io"</span>: [
    {profile.hardware_io.map((tech, i) => (
      <><span class="text-tertiary">"{tech}"</span>{i < profile.hardware_io.length - 1 ? ',' : ''}{'\n    '}</>
    ))}
  ]<span class="cursor-blink text-primary"> ▊</span>
<span class="text-tertiary">{'}'}</span></pre>
        </div>
        <div
          class="flex items-center justify-between border-t border-stone-200 bg-stone-50 px-4 py-2 font-mono text-xs text-stone-500 dark:border-surface-container-high/60 dark:bg-surface-container dark:text-on-surface-variant"
        >
          <div class="flex items-center gap-3">
            <span class="flex items-center gap-1.5 text-orange-700 dark:text-primary">
              <span class="h-1.5 w-1.5 rounded-full bg-orange-600 dark:bg-primary"></span> UTF-8
            </span>
            <span>•</span>
            <span>Node v20.11</span>
          </div>
          <button
            id="copy-json-btn"
            type="button"
            data-json={jsonPretty}
            title="Copiar configuración"
            aria-label="Copiar configuración del perfil"
            class="flex min-h-[44px] min-w-[44px] cursor-pointer items-center justify-center gap-1 px-2 text-stone-500 transition-colors hover:text-stone-900 dark:text-on-surface-variant dark:hover:text-white"
          >
            <Icon name="copy" size={15} />
            <span id="copy-json-text" class="font-mono text-[11px]" aria-live="polite">Copiar</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
