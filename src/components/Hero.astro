---
import Icon from './Icon.astro';
import Avatar from './Avatar.astro';
import { site } from '../data/site';
---

<section id="inicio" class="mx-auto grid max-w-page items-center gap-12 px-5 pb-20 pt-16 sm:px-8 md:grid-cols-[1.4fr_1fr] md:pb-28 md:pt-24">
  <div>
    <p class="rise mb-6 inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-sm text-muted">
      <span class="h-2 w-2 rounded-full bg-soft-ink" aria-hidden="true"></span>
      {site.availability}
    </p>
    <h1 class="rise text-5xl font-semibold leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl" style="--d: 80ms">
      Hola, soy <em class="font-medium text-accent">{site.firstName}</em>.
    </h1>
    <p class="rise mt-6 max-w-xl text-lg leading-relaxed text-muted sm:text-xl" style="--d: 160ms">
      {site.role} en {site.location}. {site.intro}
    </p>
    <div class="rise mt-9 flex flex-wrap items-center gap-x-6 gap-y-4" style="--d: 240ms">
      <a
        href="#proyectos"
        class="inline-flex min-h-[48px] items-center gap-2 rounded-full bg-ink px-6 font-semibold text-bg transition-colors hover:bg-accent-ink"
      >
        Ver proyectos <Icon name="arrow-down" size={18} />
      </a>
      <a href="#contacto" class="link">Hablemos de tu proyecto</a>
    </div>
  </div>

  <div class="rise" style="--d: 200ms"><Avatar /></div>
</section>
